<% layout('/layouts/boilerplate') -%>
<div class="row">
    <div class="col-8 offset-2">
        <h1 class="col-6 offset-3">Sign Up for ___________</h1>
        <form action="/signup" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
    
                <label class="form-label" for="username">Enter Username</label>
                <input id="username" name="username" placeholder="username"  type="text" class="form-control" required>
                <div class="valid-feedback">looks Good</div>
            </div>

            <div class="mb-3">
    
                <label class="form-label" for="email">Enter Email</label>
                <input id="email" name="email"  type="email" class="form-control" required>
                <!-- <div class="valid-feedback">looks Good</div> -->
            </div>

            <div class="mb-3">
    
                <label class="form-label" for="password">Enter password</label>
                <input id="password" name="password"  type="password" class="form-control" required>
                <!-- <div class="valid-feedback">looks Good</div> -->
            </div>

            <button class="btn btn-success">Sign up</button>
        </form>
    </div>
</div>